#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage (from a years/YEAR/dayDD directory):
  aocctl download
  aocctl run
  aocctl test
  aocctl submit
  aocctl commit
  aocctl context

Shell setup:
  eval "$(aocctl shell-init)"
EOF
  exit 2
}

[[ $# -ge 1 ]] || usage
command=$1
shift

if [[ $command == shell-init ]]; then
  [[ $# -eq 0 ]] || usage
  cat <<'EOF'
next-day() {
  if [[ $# -ne 0 ]]; then
    echo "Usage: next-day" >&2
    return 2
  fi

  local next_dir
  next_dir=$(command aocctl next-day-path) || return
  builtin cd -- "$next_dir"
}
EOF
  exit
fi

repo_root=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null) || {
  echo "aocctl must be run inside the Advent of Code repository." >&2
  exit 1
}

relative_dir=$(realpath "$PWD" | sed "s#^$(realpath "$repo_root")/##")
if [[ $relative_dir =~ ^years/(20(1[5-9]|2[0-5]))/day(0[1-9]|1[0-9]|2[0-5])(/.*)?$ ]]; then
  year=${BASH_REMATCH[1]}
  day=$((10#${BASH_REMATCH[3]}))
  day_dir=$(printf 'years/%s/day%02d' "$year" "$day")
else
  echo "Run aocctl from a year/day folder, for example: years/2025/day01" >&2
  exit 1
fi

if [[ $year == 2025 && $day -gt 12 ]]; then
  echo "Advent of Code 2025 only has days 1-12." >&2
  exit 1
fi

case $command in
  next-day-path)
    [[ $# -eq 0 ]] || usage
    next_day=$((day + 1))
    next_dir=$(printf '%s/years/%s/day%02d' "$repo_root" "$year" "$next_day")
    if [[ ! -d $next_dir ]]; then
      next_year=$((year + 1))
      next_dir=$(printf '%s/years/%s/day01' "$repo_root" "$next_year")
    fi
    if [[ ! -d $next_dir ]]; then
      echo "There is no day after Advent of Code $year, day $day in this repository." >&2
      exit 1
    fi
    printf '%s\n' "$next_dir"
    ;;
  context)
    [[ $# -eq 0 ]] || usage
    printf 'Advent of Code %s, day %s\n' "$year" "$day"
    ;;
  download)
    [[ $# -eq 0 ]] || usage
    "$repo_root/scripts/download.sh" "$year" "$day"
    ;;
  run)
    [[ $# -eq 0 ]] || usage
    "$repo_root/scripts/run.sh" "$year" "$day"
    ;;
  test)
    [[ $# -eq 0 ]] || usage
    "$repo_root/scripts/test.sh" "$year" "$day"
    ;;
  commit)
    [[ $# -eq 0 ]] || usage
    branch=$(git -C "$repo_root" symbolic-ref --quiet --short HEAD) || {
      echo "Cannot commit and push from a detached HEAD." >&2
      exit 1
    }
    upstream=$(git -C "$repo_root" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) || {
      echo "Branch '$branch' does not have an upstream branch." >&2
      echo "Set its upstream before running 'aocctl commit'." >&2
      exit 1
    }
    unpublished_count=$(git -C "$repo_root" rev-list --count "$upstream..HEAD")
    if [[ $unpublished_count -ne 0 ]]; then
      echo "Branch '$branch' already has $unpublished_count unpublished commit(s)." >&2
      echo "Push or otherwise resolve them before running 'aocctl commit'." >&2
      exit 1
    fi
    while IFS= read -r -d '' staged_path; do
      if [[ $staged_path != "$day_dir" && $staged_path != "$day_dir/"* ]]; then
        echo "Already-staged changes exist outside $day_dir: $staged_path" >&2
        echo "Commit or unstage them before running 'aocctl commit'." >&2
        exit 1
      fi
    done < <(git -C "$repo_root" diff --cached --name-only -z)
    git -C "$repo_root" add -- "$day_dir"
    if git -C "$repo_root" diff --cached --quiet -- "$day_dir"; then
      echo "There are no changes to commit in $day_dir." >&2
      exit 1
    fi
    git -C "$repo_root" commit -m "solution $year day $day"
    git -C "$repo_root" push
    printf 'Pushed solution %s day %s from branch %s.\n' "$year" "$day" "$branch"
    ;;
  submit)
    [[ $# -eq 0 ]] || usage
    command -v aoc >/dev/null 2>&1 || {
      echo "aoc not found; see LOCAL_SETUP.md." >&2
      exit 1
    }
    puzzle_path="$repo_root/$day_dir/puzzle.md"
    [[ -f $puzzle_path ]] || {
      echo "Puzzle file not found: $puzzle_path" >&2
      echo "Run 'aocctl download' before submitting." >&2
      exit 1
    }
    if grep -Fq -- 'Both parts of this puzzle are complete!' "$puzzle_path"; then
      echo "Both parts of Advent of Code $year, day $day are already complete." >&2
      exit 1
    elif grep -Fq -- '--- Part Two ---' "$puzzle_path"; then
      part=2
    else
      part=1
    fi
    solution_output=$("$repo_root/scripts/run.sh" "$year" "$day")
    printf '%s\n' "$solution_output"
    answer=$(printf '%s\n' "$solution_output" | sed -n "s/^Part $part: //p" | tail -n 1)
    [[ -n $answer ]] || {
      echo "Could not find 'Part $part: ANSWER' in the Python solution output." >&2
      exit 1
    }
    printf 'Submitting year %s, day %s, part %s, answer %s\n' "$year" "$day" "$part" "$answer"
    if submission_output=$(aoc --year "$year" --day "$day" submit "$part" "$answer" 2>&1); then
      printf '%s\n' "$submission_output"
    else
      status=$?
      printf '%s\n' "$submission_output" >&2
      exit "$status"
    fi
    if [[ $submission_output == *"That's the right answer"* ]]; then
      printf 'Refreshing puzzle...\n'
      "$repo_root/scripts/download.sh" "$year" "$day"
    fi
    ;;
  *)
    usage
    ;;
esac
